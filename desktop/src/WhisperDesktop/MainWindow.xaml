<Window x:Class="WhisperDesktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:WhisperDesktop.ViewModels"
        Title="Whisper Desktop — Transcripción local"
        Height="820" Width="1000"
        MinHeight="640" MinWidth="820"
        AllowDrop="True"
        Drop="Window_Drop"
        DragOver="Window_DragOver"
        Background="{StaticResource AppBackground}">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="120"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Whisper Desktop"
                       FontSize="28" FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimary}"/>
            <TextBlock Text="Transcribí audio y video en tu PC. Nada se sube a la nube."
                       FontSize="14" Margin="0,4,0,0"
                       Foreground="{StaticResource TextSecondary}"/>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <TextBlock FontSize="12" VerticalAlignment="Center">
                    <Hyperlink Command="{Binding OpenTermsCommand}">Términos</Hyperlink>
                </TextBlock>
                <TextBlock Text=" · " FontSize="12" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                <TextBlock FontSize="12" VerticalAlignment="Center">
                    <Hyperlink Command="{Binding OpenPrivacyCommand}">Privacidad</Hyperlink>
                </TextBlock>
                <TextBlock Text=" · " FontSize="12" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                <TextBlock FontSize="12" VerticalAlignment="Center">
                    <Hyperlink Command="{Binding OpenLicenseCommand}">Licencia MIT</Hyperlink>
                </TextBlock>
            </StackPanel>
        </StackPanel>

        <!-- Language + output -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="16" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Idioma" Style="{StaticResource FieldLabel}"/>
                    <ComboBox ItemsSource="{Binding Languages}"
                              SelectedItem="{Binding SelectedLanguage}"
                              Margin="0,4,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="Carpeta de salida" Style="{StaticResource FieldLabel}"/>
                    <DockPanel Margin="0,4,0,0">
                        <Button DockPanel.Dock="Right" Content="…" Width="36" Margin="6,0,0,0"
                                Command="{Binding ChooseOutputFolderCommand}" ToolTip="Elegir carpeta"/>
                        <TextBox Text="{Binding OutputDirectory, UpdateSourceTrigger=PropertyChanged}"
                                 VerticalContentAlignment="Center"/>
                    </DockPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Model picker -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="16" Margin="0,0,0,10">
            <StackPanel>
                <DockPanel Margin="0,0,0,6">
                    <TextBlock Text="Modelo de Whisper" Style="{StaticResource FieldLabel}"
                               DockPanel.Dock="Left" VerticalAlignment="Center"/>
                    <TextBlock DockPanel.Dock="Right" HorizontalAlignment="Right"
                               Text="Todos son gratis y privados. Más grande = mejor calidad, más descarga y más tiempo."
                               Foreground="{StaticResource TextSecondary}" FontSize="12" TextWrapping="Wrap"/>
                </DockPanel>

                <ListBox ItemsSource="{Binding Models}"
                         SelectedItem="{Binding SelectedModel}"
                         BorderThickness="0"
                         Background="Transparent"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         MaxHeight="220">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="2"/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0,0,8,8"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Bd"
                                                Background="#F7FAF8"
                                                BorderBrush="#D0D9D3"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                Padding="12"
                                                Cursor="Hand">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#E5F2EC"/>
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="#1F6F5B"/>
                                                <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#EEF5F1"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal">
                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="14"
                                               Foreground="{StaticResource TextPrimary}"/>
                                    <Border Margin="8,0,0,0" Padding="6,1" CornerRadius="4"
                                            Background="#1F6F5B" VerticalAlignment="Center"
                                            Visibility="{Binding IsRecommended, Converter={StaticResource BoolToVisConverter}}">
                                        <TextBlock Text="Recomendado" Foreground="White" FontSize="10" FontWeight="SemiBold"/>
                                    </Border>
                                </StackPanel>

                                <TextBlock Grid.Row="0" Grid.Column="1"
                                           Text="{Binding SizeLabel}"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource AccentBrush}"
                                           VerticalAlignment="Center"/>

                                <TextBlock Grid.Row="1" Grid.ColumnSpan="2"
                                           Text="{Binding Description}"
                                           Foreground="{StaticResource TextSecondary}"
                                           FontSize="11" TextWrapping="Wrap" Margin="0,4,0,6"/>

                                <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,0,0,2">
                                    <TextBlock Text="Velocidad" Width="70" FontSize="11"
                                               Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding SpeedDots}" FontSize="12"
                                               Foreground="#2C7A5F" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding SpeedLabel}" FontSize="11" Margin="8,0,0,0"
                                               Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                                </StackPanel>

                                <StackPanel Grid.Row="3" Grid.ColumnSpan="2" Orientation="Horizontal">
                                    <TextBlock Text="Calidad" Width="70" FontSize="11"
                                               Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding QualityDots}" FontSize="12"
                                               Foreground="#1F6F5B" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding QualityLabel}" FontSize="11" Margin="8,0,0,0"
                                               Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock Margin="0,2,0,10" FontSize="11" Foreground="{StaticResource TextSecondary}"
                           Text="La primera vez que elijas un modelo se descarga a tu PC; después queda disponible sin internet."/>

                <StackPanel Orientation="Horizontal">
                    <Button Content="Elegir archivos" Command="{Binding ChooseFilesCommand}"
                            Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"/>
                    <Button Content="Transcribir" Command="{Binding StartCommand}"
                            Style="{StaticResource AccentButton}" Margin="0,0,8,0"/>
                    <Button Content="Cancelar" Command="{Binding CancelCommand}" Margin="0,0,8,0"/>
                    <Button Content="Abrir carpeta de salida" Command="{Binding OpenOutputFolderCommand}" Margin="0,0,8,0"/>
                    <Button Content="Limpiar finalizados" Command="{Binding ClearCompletedCommand}"/>
                </StackPanel>

                <TextBlock Text="{Binding FfmpegStatus}"
                           Foreground="{StaticResource TextSecondary}"
                           FontSize="12" Margin="0,10,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- Drop zone + job list -->
        <Border Grid.Row="3" Style="{StaticResource Card}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="#F0F4F1" BorderBrush="#C5D0C8" BorderThickness="0,0,0,1" Padding="16">
                    <TextBlock Text="Arrastrá y soltá archivos aquí (.mp4, .m4a, .mp3, .wav, .mkv, …)"
                               HorizontalAlignment="Center"
                               Foreground="{StaticResource TextSecondary}"/>
                </Border>

                <ListView Grid.Row="1" ItemsSource="{Binding Jobs}" BorderThickness="0"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="12,8"/>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                    <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding StatusMessage}" Foreground="#556B5F"
                                               FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                    <ProgressBar Height="6" Margin="0,6,0,0"
                                                 Minimum="0" Maximum="100"
                                                 Value="{Binding Progress}"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding StatusDisplay}"
                                           VerticalAlignment="Center" FontWeight="Medium"/>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="Abrir .txt"
                                            Command="{Binding DataContext.OpenJobOutputCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"
                                            Margin="0,0,6,0"
                                            IsEnabled="{Binding OutputPath, Converter={StaticResource NullToBoolConverter}}"/>
                                </StackPanel>
                                <Button Grid.Column="3" Content="Quitar"
                                        Command="{Binding DataContext.RemoveJobCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}"
                                        VerticalAlignment="Center"/>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>

        <TextBlock Grid.Row="4" Text="Actividad" Style="{StaticResource FieldLabel}" Margin="0,12,0,6"/>

        <TextBox Grid.Row="5"
                 Text="{Binding StatusLog}"
                 IsReadOnly="True"
                 TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"
                 FontFamily="Consolas"
                 FontSize="12"
                 Background="#F7F7F5"
                 BorderBrush="#D0D5D2"/>
    </Grid>
</Window>
